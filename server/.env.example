# Server Configuration
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://your_connection_string_here

# JWT Secret — use a strong random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Webhook Secret for Cron Jobs
CRON_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Google Sheets Sync Credentials (optional — for Complaints Form)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SPREADSHEET_ID=
